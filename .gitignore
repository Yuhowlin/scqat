# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments. A uv-created venv already self-ignores (uv writes .venv/.gitignore = "*"),
# so this covers the hand-made `python -m venv` case. The repo-local .venv here is uv's
# project env and is where the tests run - see ENVIRONMENTS.md.
.venv*/
venv/
env/

# Personal workspace - NOT part of the published library. These trees hold the
# maintainer's exploration against real lab runs (absolute data paths, saved
# figures, throwaway scripts) and are kept locally, never published.
notebooks/
analysis/
temp/

# Claude Code / agent settings - ALL of it stays local. A committed settings.json
# ships one machine's accumulated permission grants (and its absolute paths) to
# every fork, where they would be pre-approved for someone else's agent.
.claude/settings.json
.claude/settings.local.json

# Build metadata (regenerated by every editable install)
scqat.egg-info/
*.egg-info/

# Resolver lockfile — deliberately NOT committed. scqat is a LIBRARY that other
# repos import, so pinning its transitive tree here would only describe one
# developer's machine; the consuming applications (SCQO, scqo-qblox) own the
# locks that actually matter. Regenerate locally with `uv lock` / `uv sync`.
uv.lock
